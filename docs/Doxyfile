DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = Orion
PROJECT_NUMBER         = $(ORION_PROJECT_VERSION)
OUTPUT_DIRECTORY       = ./docs/_build/doxygen

INPUT                  = ./libs ./proto
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
EXCLUDE_PATTERNS       = */build/* *_impl.hpp

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO

MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
QUIET                  = YES

# Graphviz — UML class diagrams, inheritance trees, include graphs.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 50
UML_LOOK               = YES
CLASS_GRAPH            = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
