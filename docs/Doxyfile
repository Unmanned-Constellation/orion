DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = Orion
OUTPUT_DIRECTORY       = ./docs/_build/doxygen

INPUT                  = ./libs ./proto
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp
EXCLUDE_PATTERNS       = */build/*

EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
HAVE_DOT               = NO
QUIET                  = YES
