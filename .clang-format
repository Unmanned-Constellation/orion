Language: Cpp
BasedOnStyle: Microsoft
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
    # C++ standard library headers (no extension, no path separator)
    - Regex: "^<[a-z_]+>$"
      Priority: 1
    # POSIX/System headers
    - Regex: "^<(sys/|linux/|unistd|semaphore|signal|pthread|fcntl|poll|netinet|arpa|errno|dlfcn).*>$"
      Priority: 2
    # Third-party headers (angle brackets with path or extension)
    - Regex: "^<.*>$"
      Priority: 3
    # Project headers (quoted)
    - Regex: '^".*"$'
      Priority: 4
AlignConsecutiveDeclarations: true
AlignConsecutiveAssignments: true
AlignTrailingComments: true
AlwaysBreakTemplateDeclarations: Yes
UseTab: Never
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
AllowAllArgumentsOnNextLine: true
AllowShortFunctionsOnASingleLine: All
PackConstructorInitializers: NextLine
BreakConstructorInitializers: BeforeColon
BinPackArguments: false
BinPackParameters: false
PointerAlignment: Left
