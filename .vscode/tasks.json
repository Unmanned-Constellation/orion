{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "conan-install",
      "type": "shell",
      "command": "conan export conan/recipes/zenoh-c && conan export conan/recipes/zenoh-cpp && conan install . --output-folder=build --build=missing -s build_type=Debug",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake --preset conan-debug --no-warn-unused-cli",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build --preset conan-debug",
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": "configure",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "format-clang",
      "type": "shell",
      "command": "cmake --build build --target format-clang",
      "group": "none",
      "dependsOn": "configure",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "format-cmake",
      "type": "shell",
      "command": "cmake --build build --target format-cmake",
      "group": "none",
      "dependsOn": "configure",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "tidy",
      "type": "shell",
      "command": "cmake --build build --target tidy",
      "group": "none",
      "dependsOn": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "docs",
      "type": "shell",
      "command": "cmake --build build --target docs",
      "group": "none",
      "dependsOn": "configure",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
