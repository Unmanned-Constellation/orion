{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "conan-install",
      "detail": "Install deps from cache; wipes build/ and configures both presets",
      "type": "shell",
      "command": "bash scripts/environment/initialize_conan.sh",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "conan-install (no-remote)",
      "detail": "Install deps from local cache only — no downloads",
      "type": "shell",
      "command": "bash scripts/environment/initialize_conan.sh --no-remote",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "conan-reinstall (purges cache)",
      "detail": "Purge entire Conan package cache then reinstall from scratch",
      "type": "shell",
      "command": "conan remove '*' -c && bash scripts/environment/initialize_conan.sh",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "conan-lock-create",
      "detail": "Pin all dep versions to conan.lock — run after changing conanfile.py",
      "type": "shell",
      "command": "bash -c 'case \"$(uname -m)\" in x86_64) ARCH=x86_64;; aarch64|arm64) ARCH=arm64;; esac && conan lock create . --profile=conan/profiles/${ARCH}/release --lockfile-out=conan.lock'",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "configure",
      "detail": "Run cmake --preset for the selected build type",
      "type": "shell",
      "command": "/usr/bin/cmake --preset ${input:buildType} --no-warn-unused-cli",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build",
      "detail": "Configure and build all targets for the selected build type",
      "type": "shell",
      "command": "/usr/bin/cmake --preset ${input:buildType} --no-warn-unused-cli && /usr/bin/cmake --build --preset ${input:buildType}",
      "group": {
        "kind": "build"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build (specific target)",
      "detail": "Configure then build a single named CMake target",
      "type": "shell",
      "command": "/usr/bin/cmake --preset ${input:buildType} --no-warn-unused-cli && /usr/bin/cmake --build --preset ${input:buildType} --target ${input:cmakeTarget}",
      "group": {
        "kind": "build"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "format-clang",
      "detail": "Auto-format all C++ source files with clang-format",
      "type": "shell",
      "command": "/usr/bin/cmake --build build/Debug --target format-clang",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "format-cmake",
      "detail": "Auto-format all CMakeLists.txt and .cmake files with gersemi",
      "type": "shell",
      "command": "/usr/bin/cmake --build build/Debug --target format-cmake",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "tidy",
      "detail": "Run clang-tidy static analysis on all project source",
      "type": "shell",
      "command": "/usr/bin/cmake --build build/Debug --target tidy",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "docs",
      "detail": "Generate Doxygen HTML documentation into docs/_build/doxygen",
      "type": "shell",
      "command": "/usr/bin/cmake --build build/Debug --target docs",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "CI/CD: clang-format check",
      "detail": "Dry-run clang-format — fails if any file needs reformatting",
      "type": "shell",
      "command": "find src -type f \\( -name '*.cpp' -o -name '*.hpp' \\) | xargs clang-format-18 --dry-run --Werror",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "CI/CD: gersemi check",
      "detail": "Dry-run gersemi — fails if any CMake file needs reformatting",
      "type": "shell",
      "command": "gersemi --check .",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "CI/CD: run all checks",
      "detail": "Run all format checks in parallel",
      "type": "shell",
      "command": "echo 'All checks passed.'",
      "dependsOn": [
        "CI/CD: clang-format check",
        "CI/CD: gersemi check"
      ],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "buildType",
      "type": "pickString",
      "description": "Select a build type",
      "options": ["debug", "release"],
      "default": "debug"
    },
    {
      "id": "cmakeTarget",
      "type": "promptString",
      "description": "CMake target to build",
      "default": "all"
    }
  ]
}
