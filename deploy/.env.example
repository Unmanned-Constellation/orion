# Copy to deploy/.env and fill in values before running docker compose.

# ── Required ──────────────────────────────────────────────────────────────────
MODEL_ENGINE=/opt/orion/models/rtdetr-r18.engine

# ── Optional — shown with defaults ───────────────────────────────────────────
LOG_LEVEL=info

# Vehicle identity — defaults to the system hostname if unset.
# Set explicitly when the hostname does not match the desired vehicle name.
# VEHICLE_ID=drone-1

# Clock mode — controls the TimeSource injected into periodic services.
#   wall           production and HIL (default)
#   sim:<scale>    scaled real-time SIL, e.g. sim:2.0 runs at 2x wall speed
#   coordinated    lockstep batch simulation (Phase 3 — not yet active)
CLOCK_MODE=wall

# Clock service
SIM_SCALE=1.0
SIM_RATE_HZ=100

# Perception — camera (repeat for N cameras as space-separated values)
CAMERA_DEVICE=/dev/video0
CAMERA_ID=forward
CAPTURE_WIDTH=960
CAPTURE_HEIGHT=600
CAPTURE_FPS=30

# Perception — model
MODEL_DIR=/opt/orion/models
CUSTOM_LIB=/opt/orion/lib/rtdetr_parser.so
NUM_CLASSES=80
CONF_THRESHOLD=0.5
PARSE_BBOX_FUNC=NvDsInferParseRtDetr

# Perception — tracker
TRACKER_LIB=/opt/nvidia/deepstream/deepstream/lib/libnvds_mot_iou.so

# Perception — video stream
STREAM_HOST=224.1.1.1
STREAM_PORT=5000
