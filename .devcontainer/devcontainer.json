{
  "name": "Orion Dev",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.cache/orion-ccache ${localEnv:HOME}/.cache/orion-deps && touch ${localEnv:HOME}/.gitconfig",
  "mounts": [
    "source=${localEnv:HOME}/.cache/orion-ccache,target=/ccache,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/orion-deps,target=/root/.conan2/p,type=bind,consistency=cached",
    "source=orion-vscode-server,target=/root/.vscode-server,type=volume",
    "source=orion-cmake-tools,target=/root/.local/share/CMakeTools,type=volume",
    "source=orion-claude-profile,target=/root/.claude,type=volume",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "zxh404.vscode-proto3",
        "xaver.clang-format",
        "anthropic.claude-code"
      ],
      "settings": {
        "cmake.cmakePath": "/usr/bin/cmake",
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
        "C_Cpp.default.cppStandard": "c++20",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "[cpp]": {
          "editor.tabSize": 4,
          "editor.defaultFormatter": "xaver.clang-format"
        },
        "clang-format.executable": "clang-format-18",
        "files.insertFinalNewline": true,
        "files.associations": {
            "type_traits": "cpp",
            "memory": "cpp",
            "chrono": "cpp",
            "optional": "cpp",
            "system_error": "cpp",
            "regex": "cpp",
            "any": "cpp",
            "array": "cpp",
            "atomic": "cpp",
            "bit": "cpp",
            "charconv": "cpp",
            "cmath": "cpp",
            "compare": "cpp",
            "concepts": "cpp",
            "csignal": "cpp",
            "cstddef": "cpp",
            "cstdint": "cpp",
            "cstdio": "cpp",
            "cstdlib": "cpp",
            "cstring": "cpp",
            "ctime": "cpp",
            "cwchar": "cpp",
            "forward_list": "cpp",
            "map": "cpp",
            "unordered_map": "cpp",
            "vector": "cpp",
            "exception": "cpp",
            "algorithm": "cpp",
            "functional": "cpp",
            "iterator": "cpp",
            "memory_resource": "cpp",
            "ratio": "cpp",
            "string": "cpp",
            "string_view": "cpp",
            "tuple": "cpp",
            "utility": "cpp",
            "fstream": "cpp",
            "initializer_list": "cpp",
            "iosfwd": "cpp",
            "istream": "cpp",
            "limits": "cpp",
            "mutex": "cpp",
            "new": "cpp",
            "ostream": "cpp",
            "shared_mutex": "cpp",
            "sstream": "cpp",
            "stdexcept": "cpp",
            "stop_token": "cpp",
            "thread": "cpp",
            "typeinfo": "cpp",
            "ios": "cpp",
            "locale": "cpp",
            "cctype": "cpp",
            "bitset": "cpp",
            "set": "cpp",
            "unordered_set": "cpp",
            "cinttypes": "cpp",
            "clocale": "cpp",
            "complex": "cpp",
            "condition_variable": "cpp",
            "cstdarg": "cpp",
            "cwctype": "cpp",
            "deque": "cpp",
            "list": "cpp",
            "numeric": "cpp",
            "random": "cpp",
            "source_location": "cpp",
            "future": "cpp",
            "iomanip": "cpp",
            "iostream": "cpp",
            "numbers": "cpp",
            "ranges": "cpp",
            "span": "cpp",
            "streambuf": "cpp",
            "typeindex": "cpp",
            "valarray": "cpp",
            "variant": "cpp",
            "semaphore": "cpp"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
