{
  "name": "Orion Dev",

  // --- Build & Container Configuration ---
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "gandalf",

  // seccomp=unconfined removes Docker's default syscall filter entirely.
  // The specific syscall we need is personality(ADDR_NO_RANDOMIZE), which ThreadSanitizer
  // uses to disable ASLR. Docker's default seccomp profile blocks the arg — not the syscall
  // itself — so TSan fails with ENOSYS inside the container.
  //
  // The principled fix is a custom seccomp profile that only removes the ADDR_NO_RANDOMIZE
  // argument restriction on personality while keeping all other filters intact. We chose
  // unconfined instead because it requires embedding and maintaining Docker's full ~300-entry
  // allowlist, which is not worth the cost for a dev container running only trusted tooling.
  "runArgs": [
    "--security-opt", "seccomp=unconfined",
    "--hostname=the-shire"
  ],

  // --- Features & Tooling ---
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {}
  },

  // --- Environment Variables ---
  "remoteEnv": {
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
    "GIT_COMMITTER_NAME": "${localEnv:GIT_COMMITTER_NAME}",
    "GIT_COMMITTER_EMAIL": "${localEnv:GIT_COMMITTER_EMAIL}"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/gandalf/.claude"
  },

  // --- Volumes & Mounts ---
  "mounts": [
    // Build caches
    "source=${localEnv:HOME}/.cache/orion-ccache,target=/ccache,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/orion-deps,target=/home/gandalf/.conan2,type=bind,consistency=cached",
    // Tooling profiles
    "source=orion-claude-profile,target=/home/gandalf/.claude,type=volume",
    "source=orion-agents-profile,target=/home/gandalf/.agents,type=volume",
    "source=orion-gh-profile,target=/home/gandalf/.config/gh,type=volume",
    // VS Code data
    "source=orion-vscode-server,target=/home/gandalf/.vscode-server,type=volume",
    "source=orion-cmake-tools,target=/home/gandalf/.local/share/CMakeTools,type=volume",
    // Host SSH (read-only; copied to ~/.ssh with correct permissions in postStartCommand)
    "source=${localEnv:HOME}/.ssh,target=/tmp/host-ssh,type=bind,readonly"
  ],

  // --- Lifecycle Hooks ---
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.cache/orion-ccache ${localEnv:HOME}/.cache/orion-deps && touch ${localEnv:HOME}/.gitconfig",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // --- VS Code Customizations ---
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "bufbuild.vscode-buf",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ritwickdey.LiveServer",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        // General editor
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.inlayHints.enabled": "off",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.insertFinalNewline": true,

        // Language-specific
        "[cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
          "editor.tabSize": 4
        },

        // CMake & clangd
        "cmake.cmakePath": "/usr/bin/cmake",
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}/build/Debug",
          "--clang-tidy",
          "--header-insertion=never",
          "--completion-style=detailed",
          "-j=4"
        ]
      }
    }
  }
}
