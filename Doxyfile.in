PROJECT_NAME           = "Orion"
PROJECT_NUMBER         = @PROJECT_VERSION@

INPUT                  = libs/ proto/
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp
EXCLUDE_PATTERNS       = */_deps/* */build/*

EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES

OUTPUT_DIRECTORY       = build/docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

QUIET                  = YES
